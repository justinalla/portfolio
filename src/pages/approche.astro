---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
const steps = [
  ['Comprendre avant de construire', 'Partir du terrain, de l’utilisateur et de la contrainte principale. Formuler le problème avant de choisir la technologie.'],
  ['Choisir des outils adaptés', 'Du mobile hors-ligne à une simulation web légère : retenir une solution proportionnée au besoin et aux moyens disponibles.'],
  ['Avancer par étapes concrètes', 'Construire un premier livrable, le confronter à l’usage et ajuster. Les retours guident la suite du travail.'],
  ['Documenter et transmettre', 'Rendre les choix compréhensibles, réunir les résultats et produire des documents que l’on peut reprendre et partager.'],
];
const criteria = ['Un problème réel à résoudre', 'Un marché suffisamment large', 'Une solution facile à comprendre', 'Une logistique légère et compacte', 'Une valeur perçue cohérente', 'Un angle de différenciation', 'Des ressources créatives disponibles', 'Une tendance examinée dans la durée'];
---
<Layout title="Mon approche — Justin Allaglo" active="approche/">
  <section class="page-hero container"><span class="eyebrow" data-intro>L’APPROCHE / INTENTION & MÉTHODE</span><h1 data-intro>La technologie a du sens<br /><em>quand elle sert quelqu’un.</em></h1><p data-intro>Je relie le développement, le commerce et les sciences pour créer des outils utiles. Deux convictions traversent ce travail.</p></section>
  <section class="container values-grid"><article data-reveal><span class="large-number">01</span><h2>Donner accès.</h2><p>Épargner ensemble, apprendre les gestes d’un laboratoire, comprendre des statistiques : les outils peuvent ouvrir des possibilités lorsqu’ils partent de la réalité de leurs utilisateurs.</p></article><article data-reveal><span class="large-number">02</span><h2>Garder ses racines.</h2><p>La tontine, le Fon, les récits régionaux : mon ancrage béninois nourrit mes projets. Préserver le sens d’une pratique compte autant que choisir sa traduction numérique.</p></article></section>
  <section class="approach-section"><div class="container method-grid"><div data-reveal><span class="eyebrow">LA MÉTHODE</span><h2>Penser juste.<br /><em>Avancer concret.</em></h2><p class="muted">Une démarche en quatre temps,<br />adaptée à chaque projet.</p></div><ol class="method-steps">{steps.map(([title, text], i) => <li data-reveal><span class="step-number">0{i + 1}</span><div><h3>{title}</h3><p>{text}</p></div></li>)}</ol></div></section>
  <section class="container section constraint-section" data-reveal><span class="eyebrow">CONSTRUIRE SOUS CONTRAINTE</span><h2>La sobriété,<br /><em>apprise sur le terrain.</em></h2><p>Un i5 et 4 Go de RAM ont accompagné mes premiers développements. Compiler une application ou alléger un laboratoire virtuel dans ces conditions m’a appris à faire des choix mesurés. Je garde cette attention au coût réel des outils.</p></section>
  <section class="container criteria-section"><div class="section-heading" data-reveal><div><span class="eyebrow">CÔTÉ E-COMMERCE</span><h2>Avant le lancement,<br /><em>les bonnes questions.</em></h2></div></div><ol class="criteria-grid">{criteria.map((item, i) => <li data-reveal><span>0{i + 1}</span>{item}</li>)}</ol></section>
  <ContactBand />
</Layout>
