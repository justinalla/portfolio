---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBand from '../components/ContactBand.astro';
import { projects, url } from '../data/projects';
---
<Layout active="">
  <section class="hero container">
    <div class="hero-top" data-intro><span class="eyebrow">DÉVELOPPEMENT · COMMERCE · SCIENCES</span><span class="location">Cotonou, Bénin <span aria-hidden="true">↗</span></span></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 data-intro>Des idées.<br />Du code.<br /><em>Du concret.</em></h1>
        <p class="hero-description" data-intro>Je suis Justin Allaglo. Je conçois des applications, des expériences e-commerce et des outils scientifiques qui rendent les choses plus accessibles.</p>
        <div class="hero-actions" data-intro><a class="button" href={url('travail/')}>Découvrir mon travail <span aria-hidden="true">↗</span></a><a class="subtle-link" href={url('approche/')}>Mon approche <span aria-hidden="true">→</span></a></div>
      </div>
      <aside class="hero-index" aria-label="Sélection de projets" data-intro>
        <div class="index-heading"><span class="eyebrow">LES IDÉES PRENNENT FORME</span><span class="index-cross" aria-hidden="true">✳</span></div>
        <a href={url('projets/matontine/')} class="index-project"><span class="index-number"><Icon name="mobile" /><span>01</span></span><div><span class="index-label">L’ÉPARGNE, EN COMMUN</span><h2>MaTontine</h2><p>Mobile · Flutter · Hors-ligne</p></div><span class="index-arrow" aria-hidden="true">↗</span></a>
        <a href={url('projets/biostat/')} class="index-project"><span class="index-number"><Icon name="analytics" /><span>02</span></span><div><span class="index-label">DES DONNÉES AUX RÉSULTATS</span><h2>Analyse de données</h2><p>Statistiques · Visualisation · Reporting</p></div><span class="index-arrow" aria-hidden="true">↗</span></a>
        <a href={url('projets/nova/')} class="index-project"><span class="index-number"><Icon name="shop" /><span>03</span></span><div><span class="index-label">DU PRODUIT AU MARCHÉ</span><h2>Shopify & Liquid</h2><p>Sur mesure · Intégrations IA</p></div><span class="index-arrow" aria-hidden="true">↗</span></a>
        <div class="index-footer"><span>Des disciplines qui se rencontrent.</span><span>Un même fil.</span></div>
      </aside>
    </div>
    <div class="hero-bottom"><a href="#selection">EXPLORER <span aria-hidden="true">↓</span></a><span>Penser. Construire. Transmettre.</span></div>
  </section>
  <section class="skills-strip" aria-label="Domaines de travail"><div class="container"><span class="skills-heading">MES DOMAINES</span><span class="skill-pill"><Icon name="code" />Flutter & Web</span><span class="skill-separator" aria-hidden="true">✳</span><span class="skill-pill skill-commerce"><Icon name="shop" />E-commerce</span><span class="skill-separator" aria-hidden="true">✳</span><span class="skill-pill skill-data"><Icon name="analytics" />Data & Sciences</span><span class="skill-separator" aria-hidden="true">✳</span><span class="skill-pill skill-heritage"><Icon name="landmark" />Patrimoine</span></div></section>
  <section class="section container" id="selection">
    <div class="section-heading" data-reveal><div><span class="eyebrow">01 / SÉLECTION</span><h2>Des problèmes réels.<br /><em>Des réponses concrètes.</em></h2></div><a class="text-link" href={url('travail/')}>Projets & prestations <span aria-hidden="true">↗</span></a></div>
    <div class="projects-grid">{[projects[0], projects[1], projects[2], projects[3]].map(project => <ProjectCard project={project} />)}</div>
  </section>
  <section class="approach-section">
    <div class="container approach-grid">
      <div data-reveal><span class="eyebrow">02 / LE FIL CONDUCTEUR</span><h2>Relier les mondes.<br /><em>Ouvrir des portes.</em></h2><a class="text-link" href={url('approche/')}>Découvrir mon approche <span aria-hidden="true">↗</span></a></div>
      <div class="approach-copy" data-reveal><p class="large-copy">Une app de tontine. Un projet de laboratoire virtuel. Des statistiques plus accessibles.</p><p>Des sujets différents, une intention commune : construire des outils utiles, au plus près des personnes qui en ont besoin.</p><p>Mon ancrage béninois nourrit cette démarche. La technologie prend tout son sens quand elle rencontre un usage, une culture et des contraintes réelles.</p></div>
    </div>
  </section>
  <ContactBand />
</Layout>
