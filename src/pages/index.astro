---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactBand from '../components/ContactBand.astro';
import { projects, url } from '../data/projects';
const selection = ['matontine','biostat','nova'].map(slug => projects.find(p => p.slug === slug)!);
const domains = [
 {icon:'mobile',title:'Développement web & mobile',text:'Des applications utiles, adaptées aux usages et aux moyens disponibles.',href:'travail/?domaine=code'},
 {icon:'analytics',title:'Analyse de données scientifiques',text:'Des données préparées avec soin, des analyses expliquées et des résultats lisibles.',href:'projets/biostat/'},
 {icon:'shop',title:'Shopify & Liquid',text:'Des boutiques et des pages produit personnalisées pour votre activité.',href:'projets/nova/'}
];
---
<Layout active="" title="Justin Allaglo — Développement, données & e-commerce">
 <section class="eq-hero container">
  <div class="eq-intro"><span class="eyebrow" data-intro>DÉVELOPPEMENT · DONNÉES · E-COMMERCE</span><h1 data-intro>Bonjour, moi<br />c’est Justin.</h1><p class="eq-lead" data-intro>Du code, des données<br />et des idées.</p><p data-intro>Je développe des applications, j’analyse des données scientifiques et je personnalise des boutiques Shopify. Avec un même objectif : créer des solutions utiles, ancrées dans les besoins réels.</p><div class="hero-actions" data-intro><a class="button" href="#selection">Découvrir mes projets <span aria-hidden="true">→</span></a><a class="eq-secondary" href={url('contact/')}>Me contacter</a></div></div>
  <div class="eq-collage" data-intro><div class="eq-note"><span class="eyebrow">MON POINT DE DÉPART</span><p>Comprendre.<br />Construire.<br />Transmettre.</p><span>Sciences × Technologie</span></div><a class="eq-phone" href={url('projets/matontine/')} aria-label="Découvrir MaTontine"><img src={url('images/matontine/cotisations.png')} width="561" height="1280" alt="Écran réel de suivi des cotisations dans MaTontine" fetchpriority="high" /><span>MaTontine · Flutter ↗</span></a><div class="eq-caption">Une pratique collective.<br /><strong>Un outil du quotidien.</strong></div></div>
 </section>
 <section class="container section eq-expertise"><span class="eyebrow" data-reveal>MES DOMAINES D’INTERVENTION</span><h2 data-reveal>Trois compétences,<br />un même objectif : être utile.</h2><div class="eq-domains">{domains.map((d,i)=><a href={url(d.href)} data-reveal><div class="eq-domain-top"><Icon name={d.icon} /><span>0{i+1}</span></div><h3>{d.title}</h3><p>{d.text}</p><span class="text-link">En savoir plus ↗</span></a>)}</div></section>
 <section class="container eq-journey" data-reveal><div><span class="eyebrow">MON PARCOURS</span><h2>La curiosité comme fil conducteur.</h2><p>De la technologie alimentaire au développement, mon parcours fait dialoguer les sciences, les données et la création. Depuis le Bénin, je construis des projets qui répondent à des besoins concrets.</p><a class="text-link" href={url('formation/')}>Découvrir mon parcours ↗</a></div><div class="eq-journey-art" aria-hidden="true"><span>Science</span><span>Code</span><span>Idées</span></div></section>
 <section class="container section" id="selection"><div class="section-heading" data-reveal><div><span class="eyebrow">UNE SÉLECTION</span><h2>Du besoin au projet.</h2></div><a class="text-link" href={url('travail/')}>Tous les projets ↗</a></div><div class="projects-grid">{selection.map(project=><ProjectCard project={project}/>)}</div></section>
 <ContactBand />
</Layout>
