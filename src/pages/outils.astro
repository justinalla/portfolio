---
import Layout from '../layouts/Layout.astro';
import ContactBand from '../components/ContactBand.astro';
import { url } from '../data/projects';
const groups = [
  { title: 'Développement', number: '01', intro: 'Des outils pour transformer un besoin en application.', items: ['Flutter / Dart', 'HTML / CSS / JavaScript', 'React', 'Python / Streamlit', 'Shopify Liquid / GraphQL'] },
  { title: 'Commerce & IA', number: '02', intro: 'De la recherche produit à la création et à l’analyse.', items: ['Shopify', 'Meta Ads', 'TrendTrack', 'ElevenLabs / CapCut', 'API Claude / MCP'] },
  { title: 'Veille & édition', number: '03', intro: 'Examiner les contraintes et rendre le travail partageable.', items: ['Veille DGCCRF / cosmétique UE', 'Playwright / WeasyPrint / pypdf', 'Figures SVG', 'Wireshark'] },
];
const rows = [
  ['Flutter / Dart', 'MaTontine', 'Une app de tontine avec persistance locale et partage de rapports.', 'matontine'],
  ['Liquid / GraphQL', 'NOVA™', 'Sections Shopify, offres par paliers et synchronisation du prix.', 'nova'],
  ['Choix à préciser', 'Labo microbio virtuel · En cours', 'Projet pédagogique à un stade préliminaire, sans avancée majeure à présenter.', 'labo-microbio'],
  ['Python / Streamlit', 'BioStat', 'Un prototype pour réunir les analyses et générer des rapports PDF.', 'biostat'],
  ['Playwright / pypdf', 'GBÈ & récits', 'Une chaîne de fabrication de documents avec figures et couverture.', 'gbe'],
  ['TrendTrack / Meta', 'Recherche produit', 'Croiser les signaux publicitaires et examiner les marchés.', 'recherche-produit'],
];
---
<Layout title="Outils & compétences — Justin Allaglo" active="outils/">
  <section class="page-hero container"><span class="eyebrow" data-intro>LES OUTILS / AU SERVICE DU BESOIN</span><h1 data-intro>La bonne compétence.<br /><em>Au bon endroit.</em></h1><p data-intro>Chaque outil prend son sens dans un projet. Voici ceux que j’utilise et les réalisations auxquelles ils ont contribué.</p></section>
  <section class="container tool-groups">{groups.map(group => <article data-reveal><span class="large-number">{group.number}</span><h2>{group.title}</h2><p>{group.intro}</p><ul>{group.items.map(item => <li>{item}</li>)}</ul></article>)}</section>
  <section class="container section"><div class="section-heading" data-reveal><div><span class="eyebrow">DE L’OUTIL À L’USAGE</span><h2>Les compétences,<br /><em>en contexte.</em></h2></div></div><div class="tool-rows">{rows.map(([tech, name, description, slug]) => <a href={url(`projets/${slug}/`)} class="tool-row" data-reveal><span class="tool-name">{tech}</span><div><h3>{name}</h3><p>{description}</p></div><span aria-hidden="true">↗</span></a>)}</div></section>
  <ContactBand />
</Layout>
