---
import Layout from '../../layouts/Layout.astro';
import ContactBand from '../../components/ContactBand.astro';
import { projects, url, type Project } from '../../data/projects';
export function getStaticPaths() { return projects.map(project => ({ params: { slug: project.slug }, props: { project } })); }
interface Props { project: Project; }
const { project: p } = Astro.props;
const next = projects[(projects.findIndex(project => project.slug === p.slug) + 1) % projects.length];
---
<Layout title={`${p.name} — Projet de Justin Allaglo`} description={p.summary} active="travail/">
  <section class="page-hero container project-hero"><a class="back-link" href={url('travail/')}>← Tous les projets</a><span class="eyebrow" data-intro>{p.number} / {p.category}</span><h1 data-intro>{p.name}<em>.</em></h1><p data-intro>{p.summary}</p><div class="tags" data-intro>{p.tags.map(tag => <span>{tag}</span>)}</div></section>
  {p.screenshots && <section class="container screenshot-section" aria-labelledby="screens-title">
    <div class="section-heading" data-reveal><div><span class="eyebrow">L’APPLICATION EN IMAGES</span><h2 id="screens-title">De la création<br /><em>au bilan du tour.</em></h2></div><p class="gallery-hint">Captures réelles de l’application.<br />Ouvrez une image pour voir les détails.</p></div>
    <div class="screenshot-gallery">{p.screenshots.map((shot, i) => <figure data-reveal><a class="screenshot-link" href={url(`images/${p.slug}/${shot.file}`)} data-lightbox-trigger data-title={shot.title} aria-label={`${shot.title} — agrandir la capture`}><img src={url(`images/${p.slug}/${shot.file}`)} width="561" height="1280" alt={shot.alt} loading="lazy" decoding="async" /></a><figcaption><span class="eyebrow">0{i + 1} / {['ACCUEIL', 'CRÉATION', 'COTISATIONS', 'RAPPORT'][i]}</span><h3>{shot.title}</h3><p>{shot.caption}</p></figcaption></figure>)}</div>
    <p class="gallery-note">Scénario de démonstration : deux membres, une cotisation de 5 000 FCFA chacun et un tour clôturé à 10 000 FCFA. Ces chiffres illustrent le fonctionnement de l’application.</p>
  </section>}
  {p.screenshots && <dialog class="image-overlay" data-lightbox aria-labelledby="overlay-title">
    <div class="overlay-panel">
      <div class="overlay-toolbar"><h2 id="overlay-title" data-lightbox-title>Capture de l’application</h2><button type="button" data-lightbox-close aria-label="Fermer l’image">Fermer <span aria-hidden="true">×</span></button></div>
      <img data-lightbox-image alt="" />
    </div>
  </dialog>}
  <section class="container case-study">
    <aside class:list={['case-meta', p.color]} data-reveal><span class="eyebrow">MON RÔLE</span><p>{p.role}</p><span class="eyebrow">{p.inProgress ? 'CHOIX TECHNIQUES' : 'OUTILS UTILISÉS'}</span><div class="tags">{p.tech.map(tech => <span>{tech}</span>)}</div>{p.slug === 'nova' && <a class="text-link" href="https://face-nova.com" target="_blank" rel="noopener noreferrer">Boutique NOVA™ <span aria-hidden="true">↗</span></a>}<span class="case-mark" aria-hidden="true">{p.mark}</span></aside>
    <div class="case-body"><section data-reveal><span class="eyebrow">01 / LE BESOIN</span><h2>Le point de départ</h2><p>{p.problem}</p></section><section data-reveal><span class="eyebrow">02 / LES CHOIX</span><h2>{p.inProgress ? 'État d’avancement' : 'L’approche retenue'}</h2><p>{p.approach}</p></section><section data-reveal><span class="eyebrow">{p.inProgress ? '03 / LES PISTES DE TRAVAIL' : '03 / LA RÉALISATION'}</span><h2>{p.inProgress ? 'Les prochaines étapes envisagées' : 'Ce qui a été construit'}</h2><ul class="deliverables">{p.deliverables.map(item => <li>{item}</li>)}</ul>{p.note && <p class="case-note">{p.note}</p>}</section></div>
  </section>
  <div class="container next-project" data-reveal><span class="eyebrow">PROJET SUIVANT</span><a href={url(`projets/${next.slug}/`)}>{next.name}<span aria-hidden="true">↗</span></a></div>
  <ContactBand />
</Layout>
