---
import { url } from '../data/projects';
---
<section class="container motion-section" aria-labelledby="motion-title" data-motion-scene>
 <div class="motion-copy"><span class="eyebrow">DE LA QUESTION AU RÉSULTAT</span><h2 id="motion-title">Donner du sens<br />à vos données.</h2><p>Préparer les observations, explorer les tendances, puis expliquer ce que les résultats permettent de conclure.</p><a class="text-link" href={url('projets/biostat/')}>Découvrir mon accompagnement ↗</a></div>
 <div class="motion-player">
  <div class="motion-player-top"><span>UN PROCESSUS, EN IMAGES</span><span class="motion-badge">Illustration</span></div>
  <svg class="data-film" viewBox="0 0 660 350" role="img" aria-labelledby="film-title film-desc">
   <title id="film-title">Des observations brutes à un résultat lisible</title><desc id="film-desc">Trois étapes : préparer des données, les analyser dans un graphique et les restituer dans un rapport. Les valeurs et les formes sont illustratives.</desc>
   <defs><pattern id="film-grid" width="22" height="22" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="#20483d" opacity=".07"/></pattern></defs>
   <rect width="660" height="350" rx="20" fill="#edf2e8"/><rect width="660" height="350" rx="20" fill="url(#film-grid)"/>
   <g class="film-source"><rect x="24" y="80" width="164" height="182" rx="16" fill="#fffdf8" stroke="#b7c7b9"/><text x="44" y="111" class="film-heading">Observations</text><path d="M44 126h124" stroke="#d5dfd2"/>
    {[0,1,2,3].map(i=><g class="film-row"><rect x="44" y={143+i*24} width="23" height="9" rx="3" fill="#9eb79d"/><rect x="77" y={143+i*24} width="35" height="9" rx="3" fill="#d5dfd2"/><rect x="124" y={143+i*24} width="32" height="9" rx="3" fill="#ebc9b4"/></g>)}
   </g>
   <path d="M196 174h31m-8-7 8 7-8 7M433 174h27m-8-7 8 7-8 7" fill="none" stroke="#8aa58b" stroke-width="2"/>
   <g class="film-chart"><rect x="236" y="50" width="190" height="242" rx="20" fill="#20483d"/><text x="259" y="84" class="film-heading" fill="#fffdf8">Analyse</text><path d="M258 246h144M258 118v128" stroke="#8fae9c"/>
    <rect class="film-bar" x="274" y="192" width="24" height="54" rx="4" fill="#a8c6a0"/><rect class="film-bar" x="314" y="156" width="24" height="90" rx="4" fill="#c0d3ad"/><rect class="film-bar" x="354" y="124" width="24" height="122" rx="4" fill="#ebc9b4"/>
    <path class="film-line" d="M285 172 326 135 366 104" fill="none" stroke="#fffdf8" stroke-width="2" stroke-linecap="round" pathLength="100"/>
   </g>
   <g class="film-report"><rect x="469" y="80" width="164" height="182" rx="16" fill="#fffdf8" stroke="#b7c7b9"/><text x="489" y="111" class="film-heading">Restitution</text><rect x="489" y="135" width="121" height="10" rx="4" fill="#a8c6a0"/><rect x="489" y="158" width="100" height="6" rx="3" fill="#d5dfd2"/><rect x="489" y="174" width="112" height="6" rx="3" fill="#d5dfd2"/><rect x="489" y="190" width="80" height="6" rx="3" fill="#d5dfd2"/><circle class="film-check" cx="597" cy="227" r="16" fill="#20483d"/><path class="film-check" d="m590 227 5 5 9-10" fill="none" stroke="#fff" stroke-width="2"/></g>
   <g class="film-steps"><text x="106" y="326" text-anchor="middle">01 · Préparer</text><text x="331" y="326" text-anchor="middle">02 · Analyser</text><text x="551" y="326" text-anchor="middle">03 · Expliquer</text></g>
  </svg>
  <div class="motion-controls"><p>Schéma illustratif · aucune donnée client</p><button type="button" class="motion-toggle" data-motion-toggle hidden>Mettre en pause</button></div>
 </div>
</section>
