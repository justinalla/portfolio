---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { url } from '../data/projects';
interface Props { variant?: 'a'|'b'; }
const {variant='b'}=Astro.props;
const email='justinallaglocareer@gmail.com';
const services=[{name:'Application web ou mobile',icon:'mobile',text:'Conception et développement adaptés à vos besoins.'},{name:'Analyse de données',icon:'analytics',text:'Préparation, statistiques et restitution des résultats.'},{name:'Shopify & Liquid',icon:'shop',text:'Personnalisation de boutiques et de pages produit.'}];
---
<Layout title="Contact — Justin Allaglo" active="contact/">
<section class:list={['container eq-contact',{'contact-direct':variant==='a'}]}>
 {variant==='b' && <header class="eq-contact-heading" data-intro><span class="eyebrow">CONSTRUISONS LA SUITE</span><h1>Une idée à concrétiser ?</h1><p>Dites-moi ce que vous avez en tête. Choisissez votre domaine, puis racontez-moi votre projet.</p></header>}
 <div class="eq-contact-layout">
 {variant==='a' && <aside class="eq-contact-aside" data-intro><h1>Faisons<br />connaissance.</h1><p>Une application, des données à analyser ou une boutique Shopify à personnaliser ?</p><p>Écrivez-moi, je serai ravi d’échanger avec vous.</p><a href={`mailto:${email}`}>{email}</a></aside>}
 <form class="eq-contact-form" data-contact-form data-intro>
 {variant==='a' ? <h2>Envoyez-moi un message</h2> : <fieldset class="eq-service-picker"><legend class="sr-only">Quel est votre besoin ?</legend>{services.map((s,i)=><label class="eq-service-option"><input type="radio" name="service" value={s.name} required checked={i===0}/><Icon name={s.icon}/><strong>{s.name}</strong><span>{s.text}</span></label>)}</fieldset>}
 <div class="eq-form-panel"><div class="eq-form-row"><label>Votre nom <span aria-hidden="true">*</span><input name="name" autocomplete="name" required maxlength="120" placeholder="Votre nom" /></label><label>Votre e-mail <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" required maxlength="254" placeholder="vous@exemple.com" /></label></div>
 {variant==='a' && <label>Sujet <span aria-hidden="true">*</span><select name="service" required><option value="">Choisissez un domaine</option>{services.map(s=><option>{s.name}</option>)}<option>Autre demande</option></select></label>}
 <label>Votre message <span aria-hidden="true">*</span><textarea name="message" required minlength="10" maxlength="5000" rows="5" placeholder="Votre besoin, vos objectifs, vos contraintes…"></textarea></label>
 <p class="eq-form-note">Ce formulaire prépare un e-mail dans votre messagerie. Vous pourrez le relire avant de l’envoyer.</p><button class="button" type="submit">Préparer mon e-mail <span aria-hidden="true">→</span></button><p role="status" data-contact-status></p><noscript><p>Pour nous écrire sans JavaScript : <a href={`mailto:${email}`}>{email}</a>.</p></noscript></div>
 </form></div>
 {variant==='b' && <p class="eq-direct-email">Ou écrivez-moi directement : <a href={`mailto:${email}`}>{email}</a></p>}
 <section class="eq-next"><h2>Comment se déroule notre échange ?</h2><div class="contact-steps">{[{n:'01',title:'Échange initial',text:'Nous discutons de votre besoin, de vos objectifs et du contexte.'},{n:'02',title:'Proposition',text:'Je vous propose une approche adaptée, avec les étapes et les modalités.'},{n:'03',title:'Lancement',text:'Une fois la suite convenue, nous avançons sur un premier livrable.'}].map(s=><article data-reveal><span class="large-number">{s.n}</span><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></section>
 <p class="eq-variant-link"><a class="text-link" href={url(variant==='a'?'contact/':'contact-direct/')} >{variant==='a'?'Choisir un service':'Préférer le contact direct'} →</a></p>
</section>
</Layout>
