---
import '../styles/global.css';
import { url } from '../data/projects';
interface Props { title?: string; description?: string; active?: string; }
const { title = 'Justin Allaglo — Code, commerce & sciences', description = 'Portfolio de Justin Allaglo, à Cotonou. Applications web et mobile, e-commerce et outils scientifiques. Découvrez les projets et la méthode.', active = '' } = Astro.props;
const nav = [['', 'Accueil'], ['approche/', 'Approche'], ['travail/', 'Travail'], ['outils/', 'Outils'], ['contact/', 'Contact']];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#111a29" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;600;700&family=Fraunces:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="signature" href={url()} aria-label="Justin Allaglo, accueil"><svg class="signature-symbol" viewBox="0 0 54 60" width="44" height="49" fill="none" aria-hidden="true" focusable="false"><!-- Stroke animation inspired by SelfMadeSystem on Uiverse.io. --><defs><linearGradient id="signature-gradient" x1="0" y1="0" x2="54" y2="60" gradientUnits="userSpaceOnUse"><stop stop-color="#f1d49a"/><stop offset="1" stop-color="#bd914d"/></linearGradient></defs><g stroke="url(#signature-gradient)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path class="signature-stroke" pathLength="360" d="M31 20V42C31 56 9 56 9 43"/><circle cx="31" cy="9" r="3"/><circle class="signature-stroke signature-period" pathLength="360" cx="46" cy="48" r="3"/></g></svg><span class="signature-name">JUSTIN<br />ALLAGLO</span></a>
        <button class="menu-toggle" type="button" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle hidden><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="menu-bars" d="M4 6h16M4 12h16M4 18h16"/><path class="menu-cross" d="m6 6 12 12M6 18 18 6"/></svg></button>
        <nav id="primary-navigation" aria-label="Navigation principale">
          {nav.map(([path, label]) => <a href={url(path)} class:list={{ selected: active === path, 'nav-contact': path === 'contact/' }} aria-current={active === path ? 'page' : undefined}>{label}{path === 'contact/' && <span aria-hidden="true"> ↗</span>}</a>)}
        </nav>
      </div>
      <div class="reading-progress" aria-hidden="true"></div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-top">
        <a class="footer-name" href={url()}>Justin Allaglo<span>.</span></a>
        <p>Le code, le commerce<br />et un ancrage béninois.</p>
        <a class="text-link" href="mailto:justinallaglocareer@gmail.com">Écrivez-moi <span aria-hidden="true">↗</span></a>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Justin Allaglo</span><span>Cotonou, Bénin · UTC+1</span><a href={url('travail/')}>Explorer les projets</a></div>
    </footer>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
